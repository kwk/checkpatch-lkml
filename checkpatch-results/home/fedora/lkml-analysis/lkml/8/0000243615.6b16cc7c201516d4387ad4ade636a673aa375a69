CHECK:ALLOC_SIZEOF_STRUCT: Prefer kzalloc(sizeof(*dml)...) over kzalloc(sizeof(struct display_mode_lib)...)
#101: FILE: drivers/gpu/drm/amd/display/dc/core/dc.c:2292:
