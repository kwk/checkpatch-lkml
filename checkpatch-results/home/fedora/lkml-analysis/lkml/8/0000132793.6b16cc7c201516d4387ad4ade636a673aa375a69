CHECK:UNNECESSARY_PARENTHESES: Unnecessary parentheses around 'port->port_id == VIP_PORTB'
#873: FILE: drivers/media/platform/ti-vpe/vip.c:738:
+		if ((port->port_id == VIP_PORTB) ||
