CHECK:UNNECESSARY_PARENTHESES: Unnecessary parentheses around 'iort_node->type == ACPI_IORT_NODE_SMMU'
#204: FILE: drivers/acpi/arm64/iort.c:587:
+		if ((iort_node->type == ACPI_IORT_NODE_SMMU) ||
