CHECK:ALLOC_SIZEOF_STRUCT: Prefer kmalloc(sizeof(*buf)...) over kmalloc(sizeof(struct virtio_balloon_page_chunk_hdr)...)
#558: FILE: drivers/virtio/virtio_balloon.c:829:
