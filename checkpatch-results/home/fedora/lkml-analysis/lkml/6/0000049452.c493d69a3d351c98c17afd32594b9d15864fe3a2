WARNING:BRACES: braces {} are not necessary for single statement blocks
#93: FILE: tools/testing/selftests/net/tls.c:205:
+	while (recvs++ < sends) {
 		EXPECT_NE(recv(self->fd, mem, send_len, 0), -1);
