CHECK:BRACES: Blank lines aren't necessary after an open brace '{'
#149: FILE: drivers/pci/probe.c:386:
+	if ((pmem & PCI_PREF_RANGE_TYPE_MASK) == PCI_PREF_RANGE_TYPE_64) {
