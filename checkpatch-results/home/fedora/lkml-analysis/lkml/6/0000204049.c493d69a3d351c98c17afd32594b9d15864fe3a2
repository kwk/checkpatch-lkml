CHECK:UNNECESSARY_PARENTHESES: Unnecessary parentheses around 'ieee->queue_stop'
#110: FILE: drivers/staging/rtl8192u/ieee80211/ieee80211_softmac.c:263:
+		if (!ieee->check_nic_enough_desc(ieee->dev, tcb_desc->queue_index) || \
