WARNING:TRAILING_SEMICOLON: macros should not use a trailing semicolon
#268: FILE: tools/power/crypto/crypto_hibernate.c:109:
+#define RND(a,b,c,d,e,f,g,h,i)                         \
+     t0 = h + Sigma1(e) + Ch(e, f, g) + K[i] + W[i];   \
