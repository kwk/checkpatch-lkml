WARNING:BRACES: braces {} are not necessary for single statement blocks
#137: FILE: tools/testing/selftests/bpf/progs/test_tunnel_kern.c:587:
+	if (iph->protocol == IPPROTO_ICMP) {
+		key.remote_ipv6[3] = bpf_htonl(0x11); /* ::11 */
