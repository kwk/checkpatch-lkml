CHECK:BIT_MACRO: Prefer using the BIT macro
#98: FILE: tools/testing/selftests/seccomp/seccomp_bpf.c:239:
+#define SECCOMP_USER_NOTIF_FLAG_WAIT_KILLABLE	(1UL << 0) /* Prevent task from being interrupted */

