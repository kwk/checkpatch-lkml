CHECK:UNNECESSARY_PARENTHESES: Unnecessary parentheses around 'dev->msg_write_idx > 0'
#58: FILE: drivers/i2c/busses/i2c-designware-core.c:439:
+			if ((dev->master_cfg & DW_IC_CON_RESTART_EN) &&
