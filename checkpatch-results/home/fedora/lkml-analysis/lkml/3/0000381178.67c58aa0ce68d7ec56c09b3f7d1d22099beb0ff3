CHECK:BRACES: Blank lines aren't necessary after an open brace '{'
#140: FILE: drivers/mtd/nand/nand_base.c:2981:
+		(onfi_feature(chip) & ONFI_FEATURE_EXT_PARAM_PAGE)) {
