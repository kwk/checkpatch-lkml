WARNING:MULTILINE_DEREFERENCE: Avoid multiple line dereference - prefer 'cmd->asiv[asiv_offs]'
#4707: FILE: drivers/misc/genwqe/card_dev.c:1055:
+			u_addr = be64_to_cpu(*((u64 *)&cmd->
