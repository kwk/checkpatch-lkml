CHECK:ALLOC_SIZEOF_STRUCT: Prefer kzalloc(sizeof(*slot_id)...) over kzalloc(sizeof(struct acpihp_slot_id)...)
#421: FILE: drivers/acpi/hotplug/slot_enum.c:293:
