CHECK:UNNECESSARY_PARENTHESES: Unnecessary parentheses around 'nvsp_packet->hdr.msg_type == NVSP_MSG_TYPE_INIT_COMPLETE'
#625: FILE: drivers/staging/hv/netvsc.c:880:
+	if ((nvsp_packet->hdr.msg_type == NVSP_MSG_TYPE_INIT_COMPLETE) ||
