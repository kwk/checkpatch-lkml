CHECK:ALLOC_SIZEOF_STRUCT: Prefer kzalloc(sizeof(*ds1307->nvram)...) over kzalloc(sizeof(struct bin_attribute)...)
#177: FILE: drivers/rtc/rtc-ds1307.c:896:
