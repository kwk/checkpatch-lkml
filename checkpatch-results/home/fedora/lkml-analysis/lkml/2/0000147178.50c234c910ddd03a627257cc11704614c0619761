CHECK:ALLOC_SIZEOF_STRUCT: Prefer kzalloc(sizeof(*edev->d_attrs_muex)...) over kzalloc(sizeof(struct device_attribute)...)
#260: FILE: drivers/extcon/extcon_class.c:692:
