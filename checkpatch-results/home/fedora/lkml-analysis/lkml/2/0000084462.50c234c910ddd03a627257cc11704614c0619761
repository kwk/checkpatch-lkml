WARNING:BRACES: braces {} are not necessary for single statement blocks
#79: FILE: fs/open.c:949:
+		if ((flags & O_EXCL) && !(flags & O_CREAT)) {
+			printk(KERN_ERR "WTF: open(\"%s\", %d)", filename, flags);
