WARNING:BRACES: braces {} are not necessary for single statement blocks
#85: FILE: mm/page_alloc.c:694:
+	if (likely(!is_migrate_isolate(migratetype))) {
 		__mod_zone_freepage_state(zone, 1 << order, migratetype);
