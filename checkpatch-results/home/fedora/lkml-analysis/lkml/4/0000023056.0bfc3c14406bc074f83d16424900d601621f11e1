#141: FILE: drivers/extcon/extcon.c:304:
+#define INIT_PROPERTY(name, name_lower, type)				\
+	if (EXTCON_TYPE_##name || type) {				\
+		for (i = 0; i < EXTCON_PROP_##name##_CNT; i++)		\
+			cable->name_lower##_propval[i] = val;		\
+	}								\
