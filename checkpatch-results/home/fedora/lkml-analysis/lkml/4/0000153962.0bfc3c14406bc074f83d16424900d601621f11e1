WARNING:BRACES: braces {} are not necessary for single statement blocks
#10430: FILE: drivers/staging/rdma/ipath/ipath_eeprom.c:822:
+		if (len > sizeof(ifp->if_serial)) {
+			len = sizeof(ifp->if_serial);
