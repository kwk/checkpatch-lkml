CHECK:BRACES: Blank lines aren't necessary after an open brace '{'
#55: FILE: drivers/usb/dwc3/dwc3-pci.c:115:
+	     pdev->device == PCI_DEVICE_ID_SYNOPSYS_HAPSUSB31)) {
